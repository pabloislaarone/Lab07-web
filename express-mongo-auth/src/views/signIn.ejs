<%- include('partials/head') %>

<div class="auth-box">
    <h4>Iniciar sesión</h4>
    <p class="subtitle">Ingresa con tu email y password.</p>

    <form id="signin-form" novalidate>
        <div class="input-field">
            <i class="material-icons prefix">email</i>
            <input id="email" type="email" required>
            <label for="email">Email</label>
        </div>
        <div class="input-field">
            <i class="material-icons prefix">lock</i>
            <input id="password" type="password" required>
            <label for="password">Password</label>
        </div>
        <p id="form-error" class="form-error"></p>
        <button class="btn btn-brand waves-effect waves-light" type="submit">Ingresar</button>
    </form>

    <p class="switch-link">¿No tienes cuenta? <a href="/signUp">Regístrate</a></p>
</div>

<%- include('partials/scripts') %>
